# GraphQL schema example
#
# https://gqlgen.com/getting-started/

type Todo {
  id: ID!
  text: String!
  summery: String
  done: Boolean!
}


type Query {
  todos: [Todo!]!
}

input NewTodo {
  text: String!
}

input UpdateTodo {
  text: String
}

type Mutation {
  createTodo(input: NewTodo!): Todo!
  updateTodo(input: UpdateTodo!): Todo!
}
